# AI SERVICE

AI_SERVICE_PORT=8000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_STORE_PATH=./chroma_store
LLM_MODEL=tinyllama
MAX_CONTEXT_LENGTH=12000

# Internal Docker DNS
OLLAMA_HOST=http://ollama:11434

# BACKEND (Rust)

RUST_BACKEND_PORT=8080
RUST_LOG=info

MONGO_URI=mongodb://root:example@mongo:27017
MONGO_DB_NAME=ai_code_explorer

AI_SERVICE_URL=http://ai-service:8000

# Frontend (NGINX runtime)
# Used by the frontend container to proxy /api/* to the backend.
# Can be an absolute URL with optional path prefix.
BACKEND_URL=http://backend:8080

# Browser-origin CORS (host browser → container)
FRONTEND_API_URL=http://localhost:5173

# MongoDB

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
