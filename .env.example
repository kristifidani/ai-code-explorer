############################## MongoDB Configuration ##############################

MONGO_INITDB_ROOT_USERNAME=""
MONGO_INITDB_ROOT_PASSWORD=""

############################## AI Service Configuration ##############################

# Port for the FastAPI server
AI_SERVICE_PORT="8000"

# Embedding model for sentence transformers (e.g. sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=""

# ChromaDB storage path relative to ai-service directory (.e.g ./chroma_store)
CHROMA_STORE_PATH=""

# LLM model (e.g. "gpt-4o-mini") and API OpenAI key
LLM_MODEL=""
OPENAI_API_KEY="sk-"

# Maximum context length for LLM prompts (in characters)
# Common values: 12000 or 24000
MAX_CONTEXT_LENGTH=""

######################### Backend Service (Rust) Configuration #########################

RUST_LOG="info"

# Port for the Rust backend server
RUST_BACKEND_PORT="8080"

# MongoDB connection string for local Docker setup
MONGO_URI="mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@localhost:27017"

# MongoDB database name for storing GitHub repository data
MONGO_DB_NAME="ai_code_explorer"

# AI Service URL for backend to communicate with AI service
AI_SERVICE_URL="http://localhost:8000"

# Frontend URL for CORS and communication
FRONTEND_API_URL="http://localhost:5173"

# Backend URL for frontend to communicate with backend (only local development)
VITE_BACKEND_API_URL="http://localhost:8080"

######################### Frontend (NGINX runtime) #########################

# Used by the frontend container to proxy /api/* to the backend.
# Can be an absolute URL with optional path prefix.
BACKEND_URL="http://localhost:8080"
