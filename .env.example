# ========================================
# AI Code Explorer - Environment Variables
# ========================================
# Copy this file to .env and uncomment/modify values as needed

############################## AI Service Configuration ##############################
AI_SERVICE_PORT="8000"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
CHROMA_STORE_PATH="./chroma_store"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY="sk-"

MAX_CONTEXT_LENGTH="12000"

######################### Backend Service Configuration #########################
RUST_LOG="info"
RUST_BACKEND_PORT="8080"
MONGO_DB_NAME="ai_code_explorer"

######################### Local Development (Default) #########################
MONGO_URI="mongodb://root:example@localhost:27017"
AI_SERVICE_URL="http://localhost:8000"
FRONTEND_API_URL="http://localhost:5173"
# Browser-side (Vite) backend base URL for `npm run dev` / local development.
# This is baked into the frontend bundle when you run `npm run build`.
VITE_BACKEND_API_URL="http://localhost:8080"

# Frontend production container (NGINX runtime)
# Used when running the built frontend container (not `npm run dev`).
BACKEND_URL="http://localhost:8080"
